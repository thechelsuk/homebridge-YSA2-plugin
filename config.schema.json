{
  "pluginAlias": "YaleSyncAlarm",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Burglar Alarm"
      },
      "username": {
        "title": "Username",
        "type": "string",
        "required": true,
        "placeholder": "Your Yale username"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true,
        "placeholder": "Your Yale password"
      },
      "refreshInterval": {
        "title": "Refresh Interval",
        "type": "number",
        "required": true,
        "default": 10,
        "minimum": 1,
        "description": "Seconds between polls of the Yale API (minimum 1)."
      },
      "partialArmMode": {
        "title": "Part-arm (\"Home\") shows as",
        "type": "string",
        "default": "stay",
        "oneOf": [
          {
            "title": "Home (Stay)",
            "enum": [
              "stay"
            ]
          },
          {
            "title": "Night",
            "enum": [
              "night"
            ]
          }
        ],
        "description": "Yale has one part-arm mode (the zones set in the Yale app). Choose which HomeKit mode it is exposed as; the other is hidden."
      }
    }
  }
}
